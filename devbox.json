{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": {
    "kustomize": {
      "version":   "5.6.0",
      "platforms": ["x86_64-darwin", "aarch64-darwin", "aarch64-linux", "x86_64-linux"]
    },
    "kubernetes-controller-tools": {
      "version":   "0.18.0",
      "platforms": ["aarch64-linux", "x86_64-linux", "x86_64-darwin", "aarch64-darwin"]
    },
    "go": {
      "version":   "1.25.12",
      "platforms": ["x86_64-darwin", "aarch64-darwin", "aarch64-linux", "x86_64-linux"]
    },
    "golangci-lint": {
      "version":   "2.11.4",
      "platforms": ["x86_64-darwin", "aarch64-darwin", "aarch64-linux", "x86_64-linux"]
    },
    "operator-sdk": {
      "version":   "1.42.1",
      "platforms": ["x86_64-darwin", "aarch64-darwin", "aarch64-linux", "x86_64-linux"]
    },
    "kind": {
      "version":   "0.31.0",
      "platforms": ["x86_64-darwin", "aarch64-darwin", "aarch64-linux", "x86_64-linux"]
    },
    "kubectl": {
      "version":   "1.36.2",
      "platforms": ["x86_64-darwin", "aarch64-darwin", "aarch64-linux", "x86_64-linux"]
    },
    "eget": {
      "version":   "1.3.4",
      "platforms": ["x86_64-darwin", "aarch64-darwin", "aarch64-linux", "x86_64-linux"]
    },
    "sd": {
      "version":   "1.0.0",
      "platforms": ["x86_64-linux", "aarch64-linux", "x86_64-darwin", "aarch64-darwin"]
    }
  },
  "env": {
    "PATH":                        "$PATH:$PWD/bin",
    "OPM_VERSION":                 "1.55.0"
  },
  "shell": {
    "init_hook": [
      "[ -d \"$DEVBOX_WD/bin\" ] || mkdir -p \"$DEVBOX_WD/bin\"",
      "export EGET_OPM=\"eget operator-framework/operator-registry --tag $OPM_VERSION --to $DEVBOX_WD/bin/opm --asset=-opm\"",
      "[ -x \"$DEVBOX_WD/bin/opm\" ] || eval \"$EGET_OPM\"",
      "CURRENT_OPM_VERSION=\"$(\"$DEVBOX_WD/bin/opm\" version | sd '^.*v?(\\d+\\.\\d+\\.\\d+).*$' '$1')\"",
      "[ \"$CURRENT_OPM_VERSION\" = \"$OPM_VERSION\" ] || eval \"$EGET_OPM\"",
      "case \"$-\" in *i*) ;; *) return 0 ;; esac",
      "SHELL_NAME=\"$(basename \"${SHELL:-sh}\")\"",
      "export SHELL_NAME",
      "if [ \"$SHELL_NAME\" = \"zsh\" ]; then autoload -Uz compinit && compinit; fi",
      "eval \"$(kustomize     completion \"$SHELL_NAME\")\"",
      "eval \"$(kind          completion \"$SHELL_NAME\")\"",
      "eval \"$(helm-operator completion \"$SHELL_NAME\")\"",
      "eval \"$(operator-sdk  completion \"$SHELL_NAME\")\"",
      "eval \"$(opm           completion \"$SHELL_NAME\")\""
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
